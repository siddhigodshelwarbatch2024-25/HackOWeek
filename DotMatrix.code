import numpy as np

# Define two vectors
a = np.array([1, 2, 3])
b = np.array([4, 5, 6])

# Calculate dot product
dot_product = np.dot(a, b)
print(f"Vector a: {a}")
print(f"Vector b: {b}")
print(f"Dot product of a and b: {dot_product}")

# Matrix multiplication (which involves dot products of rows and columns)
A = np.array([
    [1, 2],
    [3, 4]
])
B = np.array([
    [5, 6],
    [7, 8]
])
matrix_product = np.dot(A, B)
print(f"\nMatrix A:\n{A}")
print(f"Matrix B:\n{B}")
print(f"Matrix product (A @ B):\n{matrix_product}")
