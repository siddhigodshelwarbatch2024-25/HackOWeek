def calculate_average(python, numpy, pandas):
    return round((python + numpy + pandas) / 3, 2)


def calculate_grade(avg):
    if avg >= 90:
        return "A+"
    elif avg >= 80:
        return "A"
    elif avg >= 70:
        return "B"
    elif avg >= 60:
        return "C"
    else:
        return "D"


print(calculate_average(85, 90, 88))
print(calculate_grade(87))
