print("========== FINAL ANALYSIS ==========")

print(
    "Overall Average:",
    round(students["Average"].mean(), 2)
)

print(
    "Highest Average:",
    round(students["Average"].max(), 2)
)

print(
    "Lowest Average:",
    round(students["Average"].min(), 2)
)

print(
    "Average Attendance:",
    round(students["Attendance"].mean(), 2)
)

print(
    "\nBest Performing Department:"
)

print(
    students.groupby("Department")["Average"]
    .mean()
    .idxmax()
)
