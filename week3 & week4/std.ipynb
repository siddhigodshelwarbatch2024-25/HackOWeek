class Student:

    def __init__(self, name, python, numpy, pandas):
        self.name = name
        self.python = python
        self.numpy = numpy
        self.pandas = pandas

    def average(self):
        return round(
            (self.python + self.numpy + self.pandas) / 3, 2
        )

    def display(self):
        print("Student:", self.name)
        print("Average:", self.average())


student1 = Student("Aarav", 85, 90, 88)
student1.display()
