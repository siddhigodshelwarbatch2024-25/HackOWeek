# List comprehension
high_scorers = [
    score for score in students["Python"]
    if score >= 80
]

print("Python scores >= 80:")
print(high_scorers)


# Dictionary comprehension
subject_averages = {
    subject: round(students[subject].mean(), 2)
    for subject in ["Python", "NumPy", "Pandas"]
}

print("\nSubject averages:")
print(subject_averages)
