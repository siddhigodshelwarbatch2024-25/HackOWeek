import numpy as np

student = np.array([5, 80, 90])
weights = np.array([0.4, 0.3, 0.3])

# Dot product
score = np.dot(student, weights)

print("Weighted score:", score)

# Manual dot product
manual = (
    student[0] * weights[0]
    + student[1] * weights[1]
    + student[2] * weights[2]
)

print("Manual dot product:", manual)
