import numpy as np

# -------------------------
# Dataset
# -------------------------

# [study_hours, attendance, assignment]
X = np.array([
    [2, 60, 50],
    [3, 65, 60],
    [4, 70, 70],
    [5, 75, 80],
    [6, 80, 85],
    [7, 85, 90],
    [8, 90, 95],
    [9, 95, 98]
], dtype=float)

# Target
# 0 = Fail
# 1 = Pass
y = np.array([
    0, 0, 0, 1,
    1, 1, 1, 1
], dtype=float)

# Normalize data
X[:, 0] = X[:, 0] / 10
X[:, 1] = X[:, 1] / 100
X[:, 2] = X[:, 2] / 100


# -------------------------
# Sigmoid function
# -------------------------

def sigmoid(x):
    return 1 / (1 + np.exp(-x))


# -------------------------
# Initial weights
# -------------------------

np.random.seed(42)

weights = np.random.randn(3)
bias = 0.0

learning_rate = 0.1
epochs = 5000


# -------------------------
# Training
# -------------------------

for epoch in range(epochs):

    # Forward pass
    z = np.dot(X, weights) + bias

    predictions = sigmoid(z)

    # Binary cross entropy
    loss = -np.mean(
        y * np.log(predictions + 1e-8)
        + (1 - y) * np.log(1 - predictions + 1e-8)
    )

    # -------------------------
    # Backpropagation
    # -------------------------

    dz = predictions - y

    dw = np.dot(X.T, dz) / len(X)
    db = np.mean(dz)

    # Update
    weights -= learning_rate * dw
    bias -= learning_rate * db

    if epoch % 500 == 0:
        print(
            f"Epoch {epoch}, Loss: {loss:.4f}"
        )


# -------------------------
# Testing
# -------------------------

test_student = np.array([
    6,     # study hours
    85,    # attendance
    90     # assignment
], dtype=float)

test_student[0] /= 10
test_student[1] /= 100
test_student[2] /= 100

z = np.dot(test_student, weights) + bias

probability = sigmoid(z)

print("\nPass probability:",
      probability * 100, "%")

if probability >= 0.5:
    print("Prediction: PASS")
else:
    print("Prediction: FAIL")
