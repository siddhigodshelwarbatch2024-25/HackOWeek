import numpy as np

# Data
x = np.array([1, 2, 3, 4, 5])
y = np.array([2, 4, 6, 8, 10])

# Initial values
w = 0.0
b = 0.0

learning_rate = 0.01
epochs = 1000

for epoch in range(epochs):

    # Prediction
    y_pred = w * x + b

    # Error
    error = y_pred - y

    # Gradients
    dw = (2 / len(x)) * np.sum(error * x)
    db = (2 / len(x)) * np.sum(error)

    # Update
    w = w - learning_rate * dw
    b = b - learning_rate * db

    if epoch % 100 == 0:
        loss = np.mean(error ** 2)
        print(f"Epoch {epoch}, Loss: {loss:.4f}")

print("\nFinal weight:", w)
print("Final bias:", b)

# Prediction
print("\nPrediction for x=6:", w * 6 + b)
