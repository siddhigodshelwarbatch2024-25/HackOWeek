import numpy as np

# Input
x = 2.0

# Target
target = 10.0

# Initial parameters
w = 1.0
b = 1.0

learning_rate = 0.01

for step in range(1000):

    # ----------------
    # Forward pass
    # ----------------
    z = w * x + b

    prediction = z

    # Loss
    loss = (prediction - target) ** 2

    # ----------------
    # Backpropagation
    # ----------------

    dL_dprediction = 2 * (prediction - target)

    dprediction_dz = 1

    dz_dw = x
    dz_db = 1

    # Chain rule
    dL_dw = (
        dL_dprediction
        * dprediction_dz
        * dz_dw
    )

    dL_db = (
        dL_dprediction
        * dprediction_dz
        * dz_db
    )

    # Update weights
    w = w - learning_rate * dL_dw
    b = b - learning_rate * dL_db

    if step % 100 == 0:
        print(
            f"Step: {step}, "
            f"Prediction: {prediction:.2f}, "
            f"Loss: {loss:.4f}"
        )

print("\nFinal weight:", w)
print("Final bias:", b)
print("Final prediction:", w * x + b)
