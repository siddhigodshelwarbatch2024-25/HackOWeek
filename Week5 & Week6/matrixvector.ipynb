import numpy as np

A = np.array([
    [1, 2],
    [3, 4]
])

B = np.array([
    [5, 6],
    [7, 8]
])

print("A:\n", A)
print("B:\n", B)

print("\nA + B:\n", A + B)

print("\nA × B:\n", A @ B)

print("\nTranspose of A:\n", A.T)

# Matrix × vector
v = np.array([2, 3])

print("\nMatrix × Vector:")
print(A @ v)
