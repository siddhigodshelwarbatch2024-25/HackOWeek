import numpy as np

# Vector
v1 = np.array([2, 3])
v2 = np.array([4, 1])

print("Vector 1:", v1)
print("Vector 2:", v2)

# Addition
print("Addition:", v1 + v2)

# Subtraction
print("Subtraction:", v1 - v2)

# Scalar multiplication
print("Scalar multiplication:", 3 * v1)

# Magnitude
print("Magnitude:", np.linalg.norm(v1))
