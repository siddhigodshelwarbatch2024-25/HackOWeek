import sympy as sp

x, y = sp.symbols('x y')

# Function
f = x**2 + y**2

# Partial derivatives
df_dx = sp.diff(f, x)
df_dy = sp.diff(f, y)

print("Function:", f)
print("df/dx:", df_dx)
print("df/dy:", df_dy)

# Gradient at (2,3)
gradient = [
    df_dx.subs({x: 2, y: 3}),
    df_dy.subs({x: 2, y: 3})
]

print("Gradient at (2,3):", gradient)
